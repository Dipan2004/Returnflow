APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012

S3_IMAGE_BUCKET=returniq-images-local
S3_PRESIGN_EXPIRY_SECONDS=300

DYNAMODB_TABLE_NAME=returniq-main
DYNAMODB_ENDPOINT_URL=http://localhost:8001

STEP_FUNCTIONS_WORKFLOW_ARN=

SQS_HUMAN_REVIEW_QUEUE_URL=
SQS_ERROR_QUEUE_URL=
SQS_ENDPOINT_URL=

SNS_BUYER_NOTIFICATIONS_TOPIC_ARN=

SAGEMAKER_ENDPOINT_NAME=returniq-return-predictor

BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

REKOGNITION_MIN_CONFIDENCE=60.0
REKOGNITION_MAX_LABELS=25

GRADING_CONFIDENCE_THRESHOLD=87.0
FRAUD_BULK_BUY_THRESHOLD=10
FRAUD_WINDOW_HOURS=72
P2P_MAX_RADIUS_KM=5.0
QR_TOKEN_TTL_HOURS=48
EXPECTED_IMAGES_PER_RETURN=3

BASE_URL=http://localhost:8000

AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
